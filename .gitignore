# Reference-validator paper cache (rebuilt on demand). The validator's `lookup`
# command defaults to ./references_cache, so ignore it at any level.
curation/references_cache/
references_cache/

# Stray OAK ontology cache written at the repo root during validation (the
# committed label cache lives at curation/cache/, not here).
/cache/

# cGSA source workbooks (re-fetched by build_cgsa_data.py; derived TSVs are committed)
evals/cgsa/data/_workbooks/

# Semi-automated drafts (regenerable via evals/cgsa/draft/draft_cgsa.py)
curation/cgsa/drafts/
python/*/target/

# Downloads cached by curation build scripts (e.g. scripts/build_schema_scz_ranking.py).
.cache/
